{
  "name": "monopoly-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jackbox-style couch co-op Monopoly: TV shows the game, phones are the controllers.",
  "scripts": {
    "dev": "concurrently -k -n server,clients -c blue,green \"npm:dev:server\" \"npm:dev:clients\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:clients": "node scripts/build-clients.mjs --watch",
    "build": "npm run build:clients && npm run build:server",
    "build:clients": "node scripts/build-clients.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "simulate": "tsx src/server/sim.ts",
    "scenarios": "tsx src/server/scenarios.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
